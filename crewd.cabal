cabal-version: >= 1.10
name: crewd
version: 1.0.0.2
license: BSD3
license-file: LICENSE
copyright: (c) George Dowding
author: George Dowding
maintainer: George Dowding <pyrios@gmail.com>
stability: stable
homepage: http://www.haskell.org/crewd/
synopsis: Manage your crew
category: Console, Text
build-type: Simple

description:
  This is a tool to manage sail racing crews.

executable crewd
  hs-source-dirs: src
  main-is: crewd.hs
  other-modules: Schedule
  build-depends:
                base >= 4.2 && < 5,
                bytestring,
                directory,
                cassava,
                filepath,
                HTTP,
                http-client,
                http-conduit,
                tagsoup >= 0.14.8 && < 1,
                split,
                text,
                time,
                vector

  default-language: Haskell2010

executable screwd
  hs-source-dirs: src
  main-is: screwd.hs
  build-depends:
                base >= 4.2 && < 5,
                aeson,
                servant-server,
                text,
                time,
                wai,
                warp
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
