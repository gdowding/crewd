cabal-version:      3.0
name:               app
version:            0.1.0.0
synopsis:           Frontend for crewd
description:        Frontend for crewd
license:            BSD-3-Clause
license-file:       LICENSE
author:             gdowding
maintainer:         pyrios@gmail.com
copyright:          gdowding @ 2025
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

flag interactive
  default:
    False
  manual:
    True

common warnings
  ghc-options:
    -funbox-strict-fields -O2 -ferror-spans -fspecialise-aggressively -Wall

common options
  if arch(wasm32)
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
    cpp-options:
      -DWASM
    if flag (interactive)
      cpp-options:
        -DINTERACTIVE

  if arch(javascript)
     ld-options:
       -sEXPORTED_RUNTIME_METHODS=HEAP8

executable app
  import:
    options, warnings
  main-is:
    Main.hs
  build-depends:
    base < 5,
    miso >= 1.9,
    crewd,
    text,
    time
  hs-source-dirs:
    app
  default-language:
    Haskell2010
